if ENABLE_SERVER
lib_libnvc_a_SOURCES += src/server.c src/server.h
endif

# Build shared library from the same objects
lib/libnvc.so: lib/libnvc.a lib/libthirdparty.a
	$(AM_V_CCLD)$(CCLD) -shared -fPIC -o $@ \
		-Wl,--whole-archive lib/libnvc.a lib/libthirdparty.a -Wl,--no-whole-archive \
		$(zlib_LIBS) $(libdw_LIBS) $(libdwarf_LIBS) $(libffi_LIBS) \
		$(capstone_LIBS) $(libzstd_LIBS) $(jansson_LIBS) $(LLVM_LIBS) \
		$(TCL_LIBS) $(PTHREAD_LIBS) -ldl -lm

CLEANFILES += lib/libnvc.so

# Install libnvc.so alongside the binary
install-exec-hook::
	$(INSTALL_PROGRAM) lib/libnvc.so $(DESTDIR)$(libdir)/libnvc.so

uninstall-hook::
	rm -f $(DESTDIR)$(libdir)/libnvc.so

bin_nvc_SOURCES = src/nvc.c src/cosim.c src/cosim.h

EXTRA_bin_nvc_DEPENDENCIES = src/symbols.txt lib/libnvc.so

bin_nvc_LDADD = \
	-Llib -lnvc

bin_nvc_LDFLAGS = $(LDFLAGS) $(AM_LDFLAGS) $(EXPORT_LDFLAGS) \
	-Wl,-rpath,'$$ORIGIN/../lib'

if IMPLIB_REQUIRED
bin_nvc_LDFLAGS += -Wl,--out-implib=lib/libnvcimp.a

implibdir = $(pkglibdir)
implib_DATA = lib/libnvcimp.a

lib/libnvcimp.a: bin/nvc$(EXEEXT)
endif

nodist_EXTRA_bin_nvc_SOURCES =

if LLVM_STATIC
# Force linking as C++ to allow LLVM static libraries
nodist_EXTRA_bin_nvc_SOURCES += dummy.cxx   # Make sure CXXLD is defined
bin_nvc_LINK = $(CXXLD) $(AM_CFLAGS) $(CFLAGS) $(bin_nvc_LDFLAGS) -o $@
AM_V_bin_nvc_LINK = $(AM_V_CXXLD)
else
bin_nvc_LINK = $(CCLD) $(AM_CFLAGS) $(CFLAGS) $(bin_nvc_LDFLAGS) -o $@
AM_V_bin_nvc_LINK = $(AM_V_CCLD)
endif

if ENABLE_GIT_SHA
nodist_EXTRA_bin_nvc_SOURCES += gitsha.h

CLEANFILES += gitsha.h
BUILT_SOURCES += gitsha.h

GIT_SHA_CMD = git describe --always --long | sed 's/^r\(.*\)/\1/; s/\([^-]*-g\)/r\1/;s/-/./g'

gitsha.h: .git/logs/HEAD
	$(AM_V_GEN)echo "#define GIT_SHA \"$$(GIT_DIR=$(top_srcdir)/.git $(GIT_SHA_CMD))\"" > gitsha.h
endif

EXTRA_DIST += src/symbols.txt
